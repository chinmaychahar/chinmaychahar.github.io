{% assign c = include.item %}

<div class="contrib-row">
  <span class="contrib-lead">
    <a class="contrib-name" href="https://github.com/{{ c.repo }}" target="_blank" rel="external nofollow noopener">{{ c.name }}</a>
    <span class="contrib-tag">{{ c.org }}</span>
  </span>
  <span class="contrib-what">{{ c.what }}</span>
  <a class="contrib-arrow" href="{{ c.prs_url }}" target="_blank" rel="external nofollow noopener">PRs &rarr;</a>
</div>
